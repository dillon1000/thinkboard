{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "agentboard",
	"main": "../../src/worker/index.ts",
	"compatibility_date": "2026-07-19",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"preview_urls": true,
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.sql"],
			"fallthrough": true
		}
	],
	"routes": [
		{
			"pattern": "board.dillon.network",
			"custom_domain": true
		}
	],
	"observability": {
		"enabled": true
	},
	"vars": {
		"AI_MODEL": "openai/gpt-5.6-luna",
		"LOCK_IN_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
		"CONVERSATION_TITLE_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
		"AI_GATEWAY_ID": "default",
		"EMBEDDING_MODEL": "@cf/baai/bge-large-en-v1.5",
		"OCR_MODEL": "@cf/meta/llama-4-scout-17b-16e-instruct",
		"PDF_DAILY_PAGE_QUOTA": "1000",
		"PDF_STORED_BYTES_QUOTA": "2147483648",
		"BETTER_AUTH_URL": "https://board.dillon.network",
		"OAUTH_PROVIDER_ID": "campus-sso",
		"OAUTH_PROVIDER_NAME": "Passport",
		"SPOTIFY_CLIENT_ID": "5e6ae65e68db477da5bcb53474fd9ee3"
	},
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"directory": "../../dist/client",
		"run_worker_first": ["/api/*"]
	},
	"durable_objects": {
		"bindings": [
			{
				"name": "BOARD_ROOM",
				"class_name": "BoardRoom"
			},
			{
				"name": "StudyAgent",
				"class_name": "StudyAgent"
			}
		]
	},
	"exports": {
		"BoardRoom": {
			"type": "durable-object",
			"storage": "sqlite"
		},
		"StudyAgent": {
			"type": "durable-object",
			"storage": "sqlite"
		}
	},
	"kv_namespaces": [
		{
			"binding": "INTEGRATIONS",
			"id": "44d8ed38fecd4c878866db35f0e8e03d"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "agentboard",
			"database_id": "c5a5b5cd-b172-4617-bd29-c69f4c949b26",
			"migrations_dir": "./migrations"
		}
	],
	"ai": {
		"binding": "AI"
	},
	"vectorize": [
		{
			"binding": "DOCUMENT_VECTORS",
			"index_name": "agentboard-documents"
		}
	],
	"queues": {
		"producers": [
			{
				"binding": "DOCUMENT_PIPELINE",
				"queue": "agentboard-document-pipeline"
			}
		],
		"consumers": [
			{
				"queue": "agentboard-document-pipeline",
				"max_batch_size": 1,
				"max_batch_timeout": 5,
				"max_retries": 3,
				"dead_letter_queue": "agentboard-document-pipeline-dlq"
			}
		]
	},
	"r2_buckets": [
		{
			"binding": "TLDRAW_BUCKET",
			"bucket_name": "agentboard-assets",
			"preview_bucket_name": "agentboard-assets-preview"
		}
	]
}
