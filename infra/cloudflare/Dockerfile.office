FROM docker.io/cloudflare/sandbox:0.12.7

USER root

# LibreOffice supplies the Office layout engine. Poppler reports the converted PDF page count,
# and the metrically compatible fonts reduce document reflow when Microsoft fonts are absent.
RUN apt-get update \
	&& DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
		fonts-crosextra-caladea \
		fonts-crosextra-carlito \
		fonts-liberation \
		libreoffice-impress \
		libreoffice-writer \
		poppler-utils \
	&& rm -rf /var/lib/apt/lists/* \
	&& fc-cache -f
