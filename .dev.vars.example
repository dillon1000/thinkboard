BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Generic OAuth / OIDC. OAuth is enabled only when all three values are set.
OAUTH_DISCOVERY_URL=https://identity.example.com/.well-known/openid-configuration
OAUTH_CLIENT_ID=replace-with-your-oauth-client-id
OAUTH_CLIENT_SECRET=replace-with-your-oauth-client-secret
TLDRAW_LICENSE_KEY=replace-with-your-tldraw-license-key

# Spotify connection. Register http://127.0.0.1:5173/api/auth/callback/spotify
# and open the local app through 127.0.0.1 rather than localhost.
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret

# Exa powers the study agent's Search, Answer, and Crawl tools.
EXA_API_KEY=replace-with-your-exa-api-key

# OpenRouter serves the Smarter study model through Cloudflare AI Gateway.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key

# PostHog receives AI traces from each model-backed surface. Use the ingestion host for your region.
POSTHOG_PROJECT_TOKEN=replace-with-your-posthog-project-token
POSTHOG_HOST=https://us.i.posthog.com
# Set this to true to omit prompts and model outputs from AI events.
# POSTHOG_AI_PRIVACY_MODE=true

# Optional overrides
# OAUTH_PROVIDER_ID=passport
# OAUTH_PROVIDER_NAME=Passport
# OAUTH_SCOPES=openid,email,profile,offline_access
# LOCK_IN_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
# CONVERSATION_TITLE_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
